{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "/bin/zsh",
      "runtimeArgs": ["-c", "source ~/.zshrc && cd apps/backend && php artisan serve --port=8000"],
      "port": 8000
    },
    {
      "name": "storefront",
      "runtimeExecutable": "/bin/zsh",
      "runtimeArgs": ["-c", "source ~/.zshrc && cd apps/storefront && pnpm dev --port 3000"],
      "port": 3000
    }
  ]
}
